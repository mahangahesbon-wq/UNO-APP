                <div class="tab-bar">
                    <div class="tab-btn active" onclick="switchTab('teams')">Teams</div>
                    <div class="tab-btn" onclick="switchTab('managers')">Managers</div>
                    <div class="tab-btn" onclick="switchTab('commentators')">Commentary</div>
                    <div class="tab-btn" onclick="switchTab('songs')">World Cup Music</div>
                </div>

                <!-- TEAMS VIEW -->
                <div id="panel-teams" class="view-panel active">
                    <div class="item-grid" id="grid-teams"></div>
                </div>

                <!-- MANAGERS VIEW -->
                <div id="panel-managers" class="view-panel">
                    <div class="item-grid" id="grid-managers"></div>
                </div>

                <!-- COMMENTARY VIEW -->
                <div id="panel-commentators" class="view-panel">
                    <div class="item-grid" id="grid-commentators"></div>
