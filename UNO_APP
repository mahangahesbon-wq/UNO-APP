            <div><button id="audio-toggle">🎵 Music: OFF</button></div>
            <div id="team-away-ui" style="color: #ff0055;"><span id="away-score">0</span> :BOT</div>
        </div>

        <div id="canvas-container">
            <div id="menu-screen">
