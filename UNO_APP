                <!-- NEW: SONGS SHOP VIEW -->
                <div id="panel-songs" class="view-panel">
                    <div class="item-grid" id="grid-songs"></div>
                </div>

                <div class="bottom-ui">
                    <div class="currency-box" id="wallet-ui">0 💰</div>
                    <div class="action-btns">
                        <button class="game-btn" id="buy-btn">Unlock Item</button>
                        <button class="game-btn" id="kickoff-btn">Match Kickoff</button>
                    </div>
                </div>
            </div>
            
            <canvas id="pitchCanvas" width="800" height="500"></canvas>
        </div>

        <div id="commentary-box">🎤 Turn Music ON up top to play synthesised stadium beats!</div>

        <div id="mobile-controls">
            <div class="dpad">
                <div></div><div class="dpad-btn" id="pad-up">▲</div><div></div>
                <div class="dpad-btn" id="pad-left">◀</div><div style="background:transparent;"></div><div class="dpad-btn" id="pad-right">▶</div>
                <div></div><div class="dpad-btn" id="pad-down">▼</div><div></div>
            </div>
            <div id="btn-shoot">SHOOT</div>
        </div>
    </div>

